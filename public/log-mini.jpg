<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 210" width="100%" height="100%">
  <defs>
    <linearGradient id="ethioreBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1A6584" />
      <stop offset="100%" stop-color="#114E68" />
    </linearGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D8B062" />
      <stop offset="100%" stop-color="#BF9544" />
    </linearGradient>
  </defs>

  <!-- Blue/Teal Logo Background Tile -->
  <rect width="180" height="210" rx="14" fill="url(#ethioreBg)" />

  <!-- Stylized 'RE' Monogram in Warm Gold -->
  <g fill="url(#goldAccent)">
    <!-- 'R' Stem and Bowl -->
    <path d="M 32 30 
             L 50 30 
             C 68 30 76 37 76 49 
             C 76 60 67 67 52 67 
             L 46 67 
             L 46 100 
             L 32 100 Z 
             M 46 43 
             L 46 54 
             L 51 54 
             C 58 54 62 52 62 48.5 
             C 62 45 58 43 51 43 Z" />

    <!-- 'R' Leg extending into 'E' Bottom Bar -->
    <path d="M 51 65 
             L 66 65 
             L 77 87 
             L 146 87 
             L 146 100 
             L 71 100 
             C 67 100 63 97 60 92 Z" />

    <!-- 'E' Top Bar -->
    <rect x="90" y="30" width="56" height="13.5" rx="1.5" />

    <!-- 'E' Middle Bar -->
    <rect x="90" y="58" width="48" height="13" rx="1.5" />
  </g>

  <!-- Official Typography in Crisp White -->
  <text x="90" y="133" text-anchor="middle" font-family="'Inter', system-ui, -apple-system, sans-serif" font-weight="700" font-size="18.5" fill="#FFFFFF" letter-spacing="0.3">Ethiopian</text>
  <text x="90" y="157" text-anchor="middle" font-family="'Inter', system-ui, -apple-system, sans-serif" font-weight="700" font-size="17.5" fill="#FFFFFF" letter-spacing="0.3">Reinsurance</text>
  <text x="90" y="182" text-anchor="middle" font-family="'Inter', system-ui, -apple-system, sans-serif" font-weight="500" font-size="11" fill="#FFFFFF" opacity="0.9" letter-spacing="0.4">የኢትዮጵያ ሪ-ኢንሹራንስ አ.ማ</text>
</svg>